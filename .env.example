# ==============================================================
# PlacePro Root Environment Configuration (.env.example)
# ==============================================================

# Server Port & Environment
PORT=5000
NODE_ENV=production

# JWT Authentication Secret
JWT_SECRET=your_production_secure_jwt_secret_key_minimum_32_chars_here

# Database Connection URL (PostgreSQL for Render Production)
DATABASE_URL="postgresql://placepro_user:YOUR_DB_PASSWORD@dpg-xxxxxxxxxxxx-a:5432/placepro"

# Optional Frontend CORS Origin
# CORS_ORIGIN="https://placepro-web.vercel.app"
# FRONTEND_URL="https://placepro-web.vercel.app"
