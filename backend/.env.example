# ==========================================
# PlacePro Production Environment Variables
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=production

# JSON Web Token Secret (Generate a cryptographically secure 64-character key)
# e.g., openssl rand -base64 48
JWT_SECRET=your_production_secure_jwt_secret_key_minimum_64_characters_here

# Database Connection URL
# For SQLite (Local / Edge deployment):
DATABASE_URL="file:./dev.db"

# For PostgreSQL (Production Enterprise deployment):
# DATABASE_URL="postgresql://username:password@localhost:5432/placepro_db?schema=public"

# Frontend Application Origin (For Production CORS)
CORS_ORIGIN="https://placepro.yourdomain.edu"
