# ==============================================================
# PlacePro Environment Configuration (.env.example)
# ==============================================================

# 1. Server Configuration
PORT=5000
NODE_ENV=production

# 2. JSON Web Token Secret
# Generate a cryptographically secure key (e.g., openssl rand -base64 32)
JWT_SECRET=your_production_secure_jwt_secret_key_minimum_32_chars_here

# 3. Database Connection URL
# --------------------------------------------------------------
# FOR RENDER PRODUCTION (PostgreSQL):
# Use the "Internal Database URL" from your Render PostgreSQL instance:
DATABASE_URL="postgresql://placepro_user:YOUR_DB_PASSWORD@dpg-xxxxxxxxxxxx-a:5432/placepro"

# FOR LOCAL DEVELOPMENT (PostgreSQL):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/placepro"

# FOR LOCAL DEVELOPMENT (SQLite - Zero Dependency):
# DATABASE_URL="file:./dev.db"

# 4. CORS & Origin Configuration (Optional)
# Set your production frontend URL if deployed on a separate domain (e.g., Vercel)
# CORS_ORIGIN="https://placepro-web.vercel.app"
# FRONTEND_URL="https://placepro-web.vercel.app"
